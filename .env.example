# Vite defaults to /api through its local proxy. A separate backend URL is optional.
VITE_API_BASE_URL=
# Backend accepts only these local browser origins by default.
PVL_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
# Optional backend process environment (API does not load .env files automatically).
# Leave unset for ignored repository .data/ and .cache/tokenizer/<revision>/ defaults.
# PVL_DATA_DIR=D:\path\to\private-data
# PVL_TOKENIZER_DIR=D:\path\to\verified-tokenizer-directory
# D03: optional verified model directory. Never downloaded by API/startup.
# PVL_MODEL_DIR=D:\path\to\verified-e5-snapshot
PVL_MAX_UPLOAD_BYTES=10485760
# Optional Vite development proxy target.
PVL_API_PROXY_TARGET=http://127.0.0.1:8000
# D04 optional LIVE; backend process environment only. Never prefix secrets with VITE_.
PINECONE_API_KEY=
# Operator label, NOT a project lookup; verify API-key project in Pinecone console.
PVL_PINECONE_PROJECT=
# Exact target/IDs approval file only AFTER separate owner authorization; keep ignored.
# PVL_LIVE_AUTHORIZATION_FILE=D:\path\to\private-approval.json
# Hard-disable cloud construction in tests/local-only sessions.
# PVL_DISABLE_CLOUD=1
# D05 local exact search: cap after SQL filtering; never silently rank a prefix.
PVL_SEARCH_MAX_CANDIDATES=2000

# D06 backend-only; disabled until operator approves optional local Ollama setup/inference.
# API never installs, pulls, starts or probes Ollama automatically.
PVL_OLLAMA_ENABLED=0
PVL_OLLAMA_URL=http://127.0.0.1:11434
# Allowed fixed tags: qwen2.5:1.5b / qwen2.5:3b. No remote URLs/DNS/proxies/redirects.
# Runtime fixed: 4096 context, 512 reply, 2 CPU threads, 60s timeout, keep_alive=0.
# Owner-controlled opt-in for LIVE search/read (still requires per-request UI consent).
# Leave disabled unless separately approved for the exact target/quota risk.
PVL_LIVE_SEARCH_ENABLED=0
