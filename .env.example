# Vite defaults to /api through its local proxy. A separate backend URL is optional.
VITE_API_BASE_URL=
# Backend accepts only these local browser origins by default.
PVL_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
# Future phases only; never prefix server secrets with VITE_.
PINECONE_API_KEY=
