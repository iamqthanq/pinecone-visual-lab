#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
cd "$root"
if [ -x "$root/.venv/Scripts/python.exe" ]; then
  exec "$root/.venv/Scripts/python.exe" "$root/scripts/git_guard.py" pre-push "$1" "$2"
elif [ -x "$root/.venv/bin/python" ]; then
  exec "$root/.venv/bin/python" "$root/scripts/git_guard.py" pre-push "$1" "$2"
else
  exec python "$root/scripts/git_guard.py" pre-push "$1" "$2"
fi
